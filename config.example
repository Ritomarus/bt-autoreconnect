# bt-autoreconnect config
# install.sh copies this to ~/.config/bt-autoreconnect/config

# MAC address of the headphone (find it with: blueutil --paired)
# Either aa-bb-cc-dd-ee-ff or AA:BB:CC:DD:EE:FF works
TARGET_MAC="aa-bb-cc-dd-ee-ff"

# Name used in log messages only
DEVICE_NAME="WH-1000XM6"

# Optional tuning (seconds)
# POLL_CONNECTED=5      # between checks while connected
# GRACE=3               # wait after a disconnect before deciding why it happened
# SETTLE=30             # after a manual disconnect, ignore "still connected" this long

# Between reconnect attempts while the headphone is out of range
# POLL_RETRY=6          # first 10 minutes
# POLL_RETRY_MID=15     # up to an hour
# POLL_RETRY_SLOW=30    # after that

# If the headphone ends the connection, is back within STEAL_WINDOW, and then
# leaves again within YIELD_WINDOW, stop pulling it back (it wants to be on
# another device). YIELD_WINDOW=0 turns this off: always pull it back.
# If it is not back within STEAL_WINDOW it is taken to be off: no more
# reconnect attempts until it reconnects by itself when powered on.
# STEAL_WINDOW=45
# YIELD_WINDOW=180
